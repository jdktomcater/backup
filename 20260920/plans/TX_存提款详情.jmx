              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Date
import java.util.concurrent.ThreadLocalRandom
import org.apache.commons.codec.digest.DigestUtils

// 时间 yyMMddHHmmss
def time = new SimpleDateFormat(&quot;yyMMddHHmmss&quot;).format(new Date())

// 随机数
def rand1 = ThreadLocalRandom.current().nextInt(100000)
def rand2 = ThreadLocalRandom.current().nextInt(1000)

// 订单号
def merchant_order_id = &quot;TDEST${time}${rand1}${rand2}&quot;

vars.put(&quot;merchant_order_id&quot;, merchant_order_id)

// 参数
def merchant_id = vars.get(&quot;dmerchant_id&quot;)
def pay_type = vars.get(&quot;pay_type&quot;)
def pay_amt = vars.get(&quot;pay_amt&quot;)
def notify_url = vars.get(&quot;notify_url&quot;)
def return_url = vars.get(&quot;return_url&quot;)
def bank_code = vars.get(&quot;bank_code&quot;)
def Remark = vars.get(&quot;remark&quot;)
def key = vars.get(&quot;dkey&quot;)

vars.put(&quot;Remark&quot;, Remark)

// 待签名字符串
def signStr = &quot;merchant_id=${dmerchant_id}&amp;merchant_order_id=&quot; +merchant_order_id+ &quot;&amp;pay_type=${pay_type}&amp;pay_amt=${pay_amt}&amp;notify_url=${notify_url}&amp;return_url=${return_url}&amp;bank_code=${bank_code}&amp;remark=&quot;+Remark + &quot;&amp;key=${dkey}&quot;

// MD5
def sign = DigestUtils.md5Hex(signStr)
vars.put(&quot;sign&quot;, sign)
</stringProp>
            </JSR223PreProcessor>
