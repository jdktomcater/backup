        <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="记录存款单" enabled="true">
          <boolProp name="resetInterpreter">true</boolProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">import java.io.*;

//String filepath_w=&quot;/home/pzom/jmeter/apache-jmeter-5.4.3/deposit_orderID.txt&quot;;
String filepath_w=&quot;C:/Users/120803034/DBL/Git/pressure/tests/DBL/deposit_orderID.txt&quot;;
//withdraw_fast_withdrawCancelToAuto准备数据
//String filepath_w=&quot;/home/pzom/jmeter/apache-jmeter-5.4.3/merchantaccountrecord_list_withdraw_orders_20251022.txt&quot;;
File file_w=new File(filepath_w);
String data_w = &quot;${dmerchant_id},${dkey},${merchant_order_id1},${pay_amt1}\r\n&quot;;
String data=&quot;${pay_message}&quot;;
//log.info(data_w);

if(data.equals(&quot;1&quot;))
{
	try  {
	   	FileOutputStream fos=new FileOutputStream(file_w,true);
	   	fos.write(data_w.getBytes());
	   	fos.flush();
	   	fos.close();
	    } catch (IOException e) {
	    		e.printStackTrace();
	    }
}
</stringProp>
        </BeanShellPostProcessor>
