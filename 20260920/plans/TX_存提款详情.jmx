            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import org.apache.commons.codec.digest.DigestUtils;
String time =&quot;${__time(YYMMddHHmmss,)}&quot;;
String id = &quot;${__UUID}&quot;.replaceAll(&quot;-&quot;,&quot;&quot;).substring(26);
String merchant_order_id = &quot;TDEST&quot; + time +&quot;${__Random(0,99999,)}&quot;; 
vars.put(&quot;merchant_order_id&quot;,merchant_order_id);

//vars.put(&quot;merchant_order_id&quot;,&quot;USDTT0320250304183244KPVI&quot;);
vars.put(&quot;user_id&quot;,&quot;${__Random(100000,999999,)}&quot;);
//vars.put(&quot;user_id&quot;,&quot;id&quot;);
vars.put(&quot;member_account&quot;,id+&quot;_mm&quot;);
vars.put(&quot;remark&quot;,time);

String pay_amt = &quot;200.00&quot;;
//String pay_amt = &quot;${__Random(101,190,)}.00&quot;;

vars.put(&quot;pay_amt&quot;,pay_amt);

//vars.put(&quot;merchant_id&quot;,&quot;555${__Random(4,6,)}&quot;);
String amount = pay_amt.replace(&quot;.&quot;,&quot;&quot;);
//String amount = pay_amt.replace(&quot;.&quot;,&quot;&quot;).replace(&quot;6&quot;,&quot;1&quot;);

vars.put(&quot;amount&quot;,amount);

String str=&quot;merchant_id=${wmerchant_id}&amp;merchant_order_id=&quot;+merchant_order_id+&quot;&amp;pay_type=${pay_type}&amp;pay_amt=&quot;+pay_amt+&quot;&amp;notify_url=${notify_url}&amp;return_url=${return_url}&amp;bank_code=${bank_code}&amp;bank_num=${bank_num}&amp;bank_owner=${bank_owner}&amp;bank_address=${bank_address}&amp;remark=&quot;+time+&quot;&amp;key=${wkey}&quot;;
String depositorder_sign=DigestUtils.md5Hex(str);

vars.put(&quot;sign&quot;,depositorder_sign);</stringProp>
            </BeanShellPreProcessor>
