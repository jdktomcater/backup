def str = &quot;merchant_id=${vars.get(&apos;dmerchant_id&apos;)}&amp;merchant_order_id=${vars.get(&apos;dmerchant_order_id&apos;)}&amp;key=${vars.get(&apos;dkey&apos;)}&quot;

def depositorder_sign = DigestUtils.md5Hex(str)

vars.put(&quot;sign&quot;, depositorder_sign)

</stringProp>
          </JSR223PreProcessor>
