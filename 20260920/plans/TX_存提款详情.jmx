            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="记录提款订单" enabled="false">
              <boolProp name="resetInterpreter">true</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.io.*;
//压测机
//String filepath_w=&quot;/tmp/report/merchantaccountrecord_list_withdraw_orders_20251215.txt&quot;;
//本地
String filepath_w=&quot;/Users/zfgs-42/Documents/work/jmeter/jmeter/paraments/withdraw_m_key_场景1.txt&quot;;
File file_w=new File(filepath_w);
String data_w = &quot;${wmerchant_id},${wkey},${wmerchant_order_id},${pay_amt}\r\n&quot;;
String data=&quot;${pay_message}&quot;;
log.info(data_w);
log.info(data);

if(data.equals(&quot;1&quot;))
{
	try  {
	   	FileOutputStream fos=new FileOutputStream(file_w,true);
	   	fos.write(data_w.getBytes());
	   	fos.flush();
	   	fos.close();
	    } catch (IOException e) {
	    		e.printStackTrace();
	    }
}
</stringProp>
            </BeanShellPostProcessor>
