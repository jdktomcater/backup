              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">import java.text.SimpleDateFormat
import java.util.Date
import java.util.concurrent.ThreadLocalRandom
import org.apache.commons.codec.digest.DigestUtils

// 时间：yyMMddHHmmss
def time = new SimpleDateFormat(&quot;yyMMddHHmmss&quot;).format(new Date())

// 随机数
def rand1 = ThreadLocalRandom.current().nextInt(0, 100000) // 0~99999
def rand2 = ThreadLocalRandom.current().nextInt(0, 1000)   // 0~999

def Remark=&quot;${remark}&quot;
vars.put(&quot;Remark&quot;,Remark)

// 订单号
def merchant_order_id = &quot;TDEST${time}${rand1}${rand2}&quot;

vars.put(&quot;merchant_order_id&quot;, merchant_order_id)

def str=&quot;merchant_id=${dmerchant_id}&amp;merchant_order_id=&quot;+merchant_order_id+&quot;&amp;pay_type=${pay_type}&amp;pay_amt=${pay_amt}&amp;notify_url=${notify_url}&amp;return_url=${return_url}&amp;bank_code=${bank_code}&amp;remark=&quot;+Remark+&quot;&amp;key=${dkey}&quot;
def depositorder_sign=DigestUtils.md5Hex(str)

vars.put(&quot;sign&quot;,depositorder_sign)




</stringProp>
              </JSR223PreProcessor>
